// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // For Turso (production), add directUrl
  // directUrl = env("DIRECT_DATABASE_URL")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?    // For email/password auth
  accounts      Account[]
  sessions      Session[]
  purchases     Purchase[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Product purchases / User library
model Purchase {
  id              String   @id @default(cuid())
  userId          String
  productSlug     String
  productName     String
  price           Float
  currency        String   @default("USD")
  paypalOrderId   String?
  paypalPayerId   String?
  transactionId   String?
  status          String   @default("completed") // pending, completed, refunded
  downloadUrl     String?  // URL or file path for download
  downloadCount   Int      @default(0)
  maxDownloads    Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productSlug])
}

// Beta signups for Work In Progress products
model BetaSignup {
  id              String   @id @default(cuid())
  email           String
  name            String?
  productSlug     String
  productName     String
  message         String?  // Optional message from user
  status          String   @default("pending") // pending, invited, accepted, declined
  invitedAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, productSlug]) // One signup per email per product
  @@index([productSlug])
  @@index([status])
}

// Support Ticketing System
model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique // e.g. TKT-0001
  name         String
  email        String
  subject      String
  description  String
  product      String          @default("general") // product slug or "general"
  priority     String          @default("normal")   // low, normal, high, urgent
  status       String          @default("open")     // open, in_progress, waiting, resolved, closed
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     TicketMessage[]
  attachments  TicketAttachment[]

  @@index([email])
  @@index([status])
  @@index([product])
}

model TicketMessage {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     String         // "user" | "support"
  senderName String
  content    String
  createdAt  DateTime       @default(now())
  attachments TicketAttachment[]

  @@index([ticketId])
}

model TicketAttachment {
  id        String        @id @default(cuid())
  ticketId  String
  messageId String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([messageId])
}

